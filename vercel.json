{
  "buildCommand": "npm run build",
  "outputDirectory": ".site",
  "functions": {
    "api/private.js": {
      "includeFiles": "private-web/**"
    }
  },
  "framework": null,
  "redirects": [
    {"source":"/kategori/:slug","destination":"/?category=:slug","statusCode":301},
    {"source":"/kategori/:slug/","destination":"/?category=:slug","statusCode":301},
    {"source":"/tr/kategori/:slug","destination":"/tr/?category=:slug","statusCode":301},
    {"source":"/tr/kategori/:slug/","destination":"/tr/?category=:slug","statusCode":301}
  ],
  "rewrites": [
    {"source":"/harita","destination":"/harita/index.html"},
    {"source":"/harita/","destination":"/harita/index.html"},
    {"source":"/tr","destination":"/index.html"},
    {"source":"/tr/","destination":"/index.html"}
  ]
}
